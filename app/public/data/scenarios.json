[{"id": "cafe-order", "cat": "Yeme-içme", "lv": "A1", "icon": "☕", "title": "Kafede sipariş", "en": "Ordering at a café", "setting": "A busy coffee shop in London", "you": "A customer", "ai": "A friendly barista", "goal": "Bir içecek ve yiyecek sipariş et, boyutunu seç, öde.", "phrases": [["Can I have a latte, please?", "Bir latte alabilir miyim lütfen?"], ["What size would you like?", "Hangi boy olsun?"], ["For here or to go?", "Burada mı, götürmek için mi?"], ["How much is it?", "Ne kadar?"], ["Can I pay by card?", "Kartla ödeyebilir miyim?"]]}, {"id": "restaurant", "cat": "Yeme-içme", "lv": "A2", "icon": "🍽️", "title": "Restoranda", "en": "At a restaurant", "setting": "A nice restaurant in the evening", "you": "A guest", "ai": "A waiter", "goal": "Masa iste, menüyü sor, yemek sipariş et, hesabı iste.", "phrases": [["A table for two, please.", "İki kişilik bir masa lütfen."], ["Could we see the menu?", "Menüyü görebilir miyiz?"], ["What do you recommend?", "Ne önerirsiniz?"], ["I'm allergic to nuts.", "Kuruyemişe alerjim var."], ["Could we have the bill, please?", "Hesabı alabilir miyiz lütfen?"]]}, {"id": "complain-food", "cat": "Yeme-içme", "lv": "B1", "icon": "😤", "title": "Yemekten şikâyet", "en": "Complaining about food", "setting": "A restaurant", "you": "A customer whose food is cold", "ai": "The restaurant manager", "goal": "Kibarca şikâyet et ve bir çözüm (yenisi ya da indirim) al.", "phrases": [["Excuse me, I'm afraid there's a problem.", "Affedersiniz, korkarım bir sorun var."], ["My soup is cold.", "Çorbam soğuk."], ["This isn't what I ordered.", "Bu benim sipariş ettiğim şey değil."], ["Could you take it back, please?", "Geri alabilir misiniz lütfen?"], ["I'd like to speak to the manager.", "Müdürle görüşmek istiyorum."]]}, {"id": "fastfood", "cat": "Yeme-içme", "lv": "A1", "icon": "🍔", "title": "Fast food", "en": "Fast food order", "setting": "A burger restaurant counter", "you": "A hungry customer", "ai": "A cashier", "goal": "Menü sipariş et, içecek seç, ekstra iste.", "phrases": [["I'd like a cheeseburger meal.", "Bir çizburger menü istiyorum."], ["Can I get a large coke?", "Büyük boy kola alabilir miyim?"], ["No onions, please.", "Soğansız lütfen."], ["Can I have some ketchup?", "Biraz ketçap alabilir miyim?"], ["That's all, thanks.", "Hepsi bu, teşekkürler."]]}, {"id": "grocery", "cat": "Alışveriş", "lv": "A1", "icon": "🛒", "title": "Markette", "en": "At the supermarket", "setting": "A supermarket", "you": "A shopper", "ai": "A shop assistant", "goal": "Aradığın ürünü bul, fiyatını sor, kasada öde.", "phrases": [["Excuse me, where can I find milk?", "Affedersiniz, sütü nerede bulabilirim?"], ["It's in aisle five.", "Beşinci reyonda."], ["Do you have any fresh bread?", "Taze ekmeğiniz var mı?"], ["Do you need a bag?", "Poşet ister misiniz?"], ["Here's your receipt.", "Fişiniz burada."]]}, {"id": "clothes", "cat": "Alışveriş", "lv": "A2", "icon": "👕", "title": "Kıyafet almak", "en": "Buying clothes", "setting": "A clothing store", "you": "A customer", "ai": "A sales assistant", "goal": "Beden sor, dene, başka renk iste, satın al.", "phrases": [["Can I try this on?", "Bunu deneyebilir miyim?"], ["Where are the fitting rooms?", "Deneme kabinleri nerede?"], ["Do you have this in a medium?", "Bunun M bedeni var mı?"], ["It's a bit too tight.", "Biraz dar."], ["I'll take it.", "Alıyorum."]]}, {"id": "return-item", "cat": "Alışveriş", "lv": "B1", "icon": "🧾", "title": "Ürün iadesi", "en": "Returning an item", "setting": "An electronics store", "you": "A customer with a broken product", "ai": "A customer service agent", "goal": "Bozuk ürünü iade et ya da değiştir; fişini göster.", "phrases": [["I'd like to return this.", "Bunu iade etmek istiyorum."], ["It stopped working after two days.", "İki gün sonra çalışmayı bıraktı."], ["Here's the receipt.", "Fiş burada."], ["Can I get a refund?", "Paramı geri alabilir miyim?"], ["Could I exchange it instead?", "Onun yerine değiştirebilir miyim?"]]}, {"id": "bargain", "cat": "Alışveriş", "lv": "B1", "icon": "🏷️", "title": "Pazarlık", "en": "Bargaining at a market", "setting": "A street market", "you": "A tourist", "ai": "A market seller", "goal": "Fiyatı düşür ve makul bir anlaşma yap.", "phrases": [["How much do you want for this?", "Bunun için ne kadar istiyorsunuz?"], ["That's a bit expensive.", "Biraz pahalı."], ["Can you give me a discount?", "İndirim yapabilir misiniz?"], ["What's your best price?", "En iyi fiyatınız nedir?"], ["It's a deal!", "Anlaştık!"]]}, {"id": "pharmacy", "cat": "Sağlık", "lv": "A2", "icon": "💊", "title": "Eczanede", "en": "At the pharmacy", "setting": "A pharmacy", "you": "A customer with a cold", "ai": "A pharmacist", "goal": "Belirtilerini anlat ve uygun ilacı al.", "phrases": [["I have a sore throat.", "Boğazım ağrıyor."], ["I've had a headache since yesterday.", "Dünden beri başım ağrıyor."], ["Do I need a prescription?", "Reçete gerekiyor mu?"], ["How many times a day should I take it?", "Günde kaç kez almalıyım?"], ["Does it have any side effects?", "Yan etkisi var mı?"]]}, {"id": "doctor", "cat": "Sağlık", "lv": "B1", "icon": "🩺", "title": "Doktorda", "en": "At the doctor's", "setting": "A doctor's office", "you": "A patient", "ai": "A doctor", "goal": "Şikâyetini, ne zamandan beri olduğunu anlat; tavsiyeyi anla.", "phrases": [["I've been feeling sick for a few days.", "Birkaç gündür kendimi hasta hissediyorum."], ["It hurts when I breathe.", "Nefes alınca acıyor."], ["I have a fever.", "Ateşim var."], ["Is it serious?", "Ciddi mi?"], ["Should I come back next week?", "Gelecek hafta tekrar gelmeli miyim?"]]}, {"id": "dentist", "cat": "Sağlık", "lv": "B1", "icon": "🦷", "title": "Dişçide", "en": "At the dentist", "setting": "A dental clinic", "you": "A patient with toothache", "ai": "A dentist", "goal": "Ağrıyı tarif et, tedavi seçeneklerini ve fiyatı sor.", "phrases": [["I have a terrible toothache.", "Korkunç bir diş ağrım var."], ["It's sensitive to cold.", "Soğuğa hassas."], ["Will it hurt?", "Acıyacak mı?"], ["How much will the treatment cost?", "Tedavi ne kadar tutar?"], ["Can I get an appointment this week?", "Bu hafta randevu alabilir miyim?"]]}, {"id": "emergency", "cat": "Sağlık", "lv": "B1", "icon": "🚑", "title": "Acil durum", "en": "Calling emergency services", "setting": "A phone call to 112/911", "you": "A witness to an accident", "ai": "An emergency operator", "goal": "Ne olduğunu, adresi ve durumu net anlat.", "phrases": [["There's been an accident.", "Bir kaza oldu."], ["Someone is injured.", "Biri yaralandı."], ["He's not breathing.", "Nefes almıyor."], ["We're on Main Street, next to the bank.", "Ana Cadde'deyiz, bankanın yanında."], ["Please hurry!", "Lütfen acele edin!"]]}, {"id": "airport-checkin", "cat": "Seyahat", "lv": "A2", "icon": "✈️", "title": "Havalimanında check-in", "en": "Airport check-in", "setting": "An airport check-in desk", "you": "A passenger", "ai": "An airline agent", "goal": "Check-in yap, bagaj ver, koltuk seç.", "phrases": [["I'd like to check in, please.", "Check-in yapmak istiyorum."], ["Here's my passport.", "Pasaportum burada."], ["Can I have a window seat?", "Cam kenarı alabilir miyim?"], ["How many bags can I check?", "Kaç bavul verebilirim?"], ["Which gate is it?", "Hangi kapı?"]]}, {"id": "passport-control", "cat": "Seyahat", "lv": "A2", "icon": "🛂", "title": "Pasaport kontrolü", "en": "Passport control", "setting": "An immigration desk", "you": "A traveler", "ai": "An immigration officer", "goal": "Ziyaret amacını, süresini ve kalacağın yeri açıkla.", "phrases": [["I'm here on holiday.", "Tatil için buradayım."], ["I'm staying for two weeks.", "İki hafta kalacağım."], ["I'm staying at a hotel in the city centre.", "Şehir merkezinde bir otelde kalıyorum."], ["This is my return ticket.", "Bu dönüş biletim."], ["It's my first time here.", "Buraya ilk gelişim."]]}, {"id": "lost-luggage", "cat": "Seyahat", "lv": "B1", "icon": "🧳", "title": "Kayıp bagaj", "en": "Lost luggage", "setting": "A baggage claim office", "you": "A passenger whose suitcase didn't arrive", "ai": "An airline staff member", "goal": "Bavulunu tarif et, kayıt aç, ne zaman geleceğini öğren.", "phrases": [["My suitcase didn't arrive.", "Bavulum gelmedi."], ["It's a large black suitcase with a red tag.", "Kırmızı etiketli büyük siyah bir bavul."], ["Here's my baggage tag.", "Bagaj etiketim burada."], ["When will I get it back?", "Ne zaman geri alırım?"], ["Can you deliver it to my hotel?", "Otelime teslim edebilir misiniz?"]]}, {"id": "hotel-checkin", "cat": "Seyahat", "lv": "A2", "icon": "🏨", "title": "Otele giriş", "en": "Hotel check-in", "setting": "A hotel reception", "you": "A guest", "ai": "A receptionist", "goal": "Rezervasyonunu doğrula, kahvaltı ve Wi-Fi'yi sor.", "phrases": [["I have a reservation under the name Yılmaz.", "Yılmaz adına bir rezervasyonum var."], ["What time is breakfast?", "Kahvaltı saat kaçta?"], ["What's the Wi-Fi password?", "Wi-Fi şifresi ne?"], ["What time is check-out?", "Çıkış saat kaçta?"], ["Could I have a late check-out?", "Geç çıkış yapabilir miyim?"]]}, {"id": "hotel-problem", "cat": "Seyahat", "lv": "B1", "icon": "🛏️", "title": "Odada sorun", "en": "A problem with your room", "setting": "A hotel reception", "you": "An unhappy guest", "ai": "A hotel manager", "goal": "Sorunu anlat, oda değişikliği iste.", "phrases": [["The air conditioning isn't working.", "Klima çalışmıyor."], ["The room is too noisy.", "Oda çok gürültülü."], ["There's no hot water.", "Sıcak su yok."], ["Could I change rooms?", "Oda değiştirebilir miyim?"], ["I'd appreciate it if you could fix it today.", "Bugün düzeltebilirseniz minnettar olurum."]]}, {"id": "directions", "cat": "Seyahat", "lv": "A1", "icon": "🗺️", "title": "Yol tarifi", "en": "Asking for directions", "setting": "A street in a foreign city", "you": "A lost tourist", "ai": "A local person", "goal": "Müzeye nasıl gideceğini öğren.", "phrases": [["Excuse me, how do I get to the museum?", "Affedersiniz, müzeye nasıl giderim?"], ["Is it far from here?", "Buraya uzak mı?"], ["Go straight and turn left.", "Düz git ve sola dön."], ["It's on your right.", "Sağ tarafında."], ["Can I walk there?", "Oraya yürüyebilir miyim?"]]}, {"id": "taxi", "cat": "Seyahat", "lv": "A2", "icon": "🚕", "title": "Takside", "en": "Taking a taxi", "setting": "A taxi", "you": "A passenger", "ai": "A taxi driver", "goal": "Adresi söyle, süreyi sor, öde ve fiş iste.", "phrases": [["Could you take me to this address?", "Beni bu adrese götürebilir misiniz?"], ["How long will it take?", "Ne kadar sürer?"], ["Could you stop here, please?", "Burada durabilir misiniz lütfen?"], ["Keep the change.", "Üstü kalsın."], ["Can I have a receipt?", "Fiş alabilir miyim?"]]}, {"id": "train-ticket", "cat": "Seyahat", "lv": "A2", "icon": "🚆", "title": "Tren bileti", "en": "Buying a train ticket", "setting": "A train station ticket office", "you": "A traveler", "ai": "A ticket clerk", "goal": "Gidiş-dönüş bilet al, peronu ve saati öğren.", "phrases": [["A return ticket to Oxford, please.", "Oxford'a gidiş-dönüş bir bilet lütfen."], ["When is the next train?", "Bir sonraki tren ne zaman?"], ["Which platform does it leave from?", "Hangi perondan kalkıyor?"], ["Do I need to change trains?", "Aktarma yapmam gerekiyor mu?"], ["Is there a student discount?", "Öğrenci indirimi var mı?"]]}, {"id": "car-rental", "cat": "Seyahat", "lv": "B1", "icon": "🚗", "title": "Araba kiralama", "en": "Renting a car", "setting": "A car rental desk", "you": "A customer", "ai": "A rental agent", "goal": "Araç seç, sigortayı ve yakıt kuralını anla, kirala.", "phrases": [["I'd like to rent a small car for three days.", "Üç günlüğüne küçük bir araba kiralamak istiyorum."], ["Is insurance included?", "Sigorta dahil mi?"], ["Is it automatic or manual?", "Otomatik mi, manuel mi?"], ["Do I need to return it with a full tank?", "Depoyu dolu mu teslim etmeliyim?"], ["What happens if it breaks down?", "Arızalanırsa ne olur?"]]}, {"id": "tour-booking", "cat": "Seyahat", "lv": "B1", "icon": "🎟️", "title": "Tur ayarlamak", "en": "Booking a tour", "setting": "A tourist information office", "you": "A tourist", "ai": "A travel agent", "goal": "Bir günlük tur seç, neyin dahil olduğunu öğren.", "phrases": [["What tours do you have tomorrow?", "Yarın hangi turlarınız var?"], ["What's included in the price?", "Fiyata neler dahil?"], ["What time does it start?", "Saat kaçta başlıyor?"], ["Is lunch included?", "Öğle yemeği dahil mi?"], ["Do I need to book in advance?", "Önceden rezervasyon gerekiyor mu?"]]}, {"id": "meet-new", "cat": "Sosyal", "lv": "A1", "icon": "👋", "title": "Tanışma", "en": "Meeting someone new", "setting": "A party", "you": "A guest", "ai": "Another guest", "goal": "Kendini tanıt, nereli olduğunu ve ne iş yaptığını söyle, karşı tarafa sor.", "phrases": [["Hi, I'm Can. Nice to meet you.", "Merhaba, ben Can. Tanıştığımıza memnun oldum."], ["Where are you from?", "Nerelisin?"], ["What do you do?", "Ne iş yapıyorsun?"], ["How do you know Sarah?", "Sarah'ı nereden tanıyorsun?"], ["It was nice talking to you.", "Seninle konuşmak güzeldi."]]}, {"id": "small-talk", "cat": "Sosyal", "lv": "A2", "icon": "☀️", "title": "Havadan sudan sohbet", "en": "Small talk", "setting": "An office kitchen", "you": "A colleague", "ai": "Another colleague", "goal": "Hava, hafta sonu ve planlar hakkında rahat sohbet et.", "phrases": [["Lovely weather today, isn't it?", "Bugün hava çok güzel, değil mi?"], ["Did you have a good weekend?", "Hafta sonun iyi geçti mi?"], ["Any plans for the holidays?", "Tatil için planın var mı?"], ["How's it going?", "Nasıl gidiyor?"], ["Same here!", "Bende de öyle!"]]}, {"id": "invite-friend", "cat": "Sosyal", "lv": "A2", "icon": "🎉", "title": "Davet etmek", "en": "Inviting a friend", "setting": "A phone call", "you": "You", "ai": "A friend", "goal": "Arkadaşını doğum gününe davet et, gün ve saati ayarla.", "phrases": [["Are you free on Saturday?", "Cumartesi boş musun?"], ["I'm having a birthday party.", "Bir doğum günü partisi veriyorum."], ["Would you like to come?", "Gelmek ister misin?"], ["What time should I come?", "Saat kaçta geleyim?"], ["Should I bring anything?", "Bir şey getireyim mi?"]]}, {"id": "decline-invite", "cat": "Sosyal", "lv": "B1", "icon": "🙅", "title": "Kibarca reddetmek", "en": "Politely declining", "setting": "A text conversation", "you": "You", "ai": "A friend", "goal": "Bir daveti kibarca reddet ve alternatif öner.", "phrases": [["Thanks so much for inviting me.", "Davet ettiğin için çok teşekkürler."], ["I'm afraid I can't make it.", "Korkarım gelemeyeceğim."], ["I've already got plans.", "Zaten planım var."], ["Maybe another time?", "Belki başka zaman?"], ["How about next week instead?", "Onun yerine gelecek hafta nasıl?"]]}, {"id": "date", "cat": "Sosyal", "lv": "B1", "icon": "💘", "title": "İlk buluşma", "en": "A first date", "setting": "A café", "you": "You", "ai": "Your date", "goal": "Kendinden bahset, ilgi alanlarını sor, tekrar buluşmayı öner.", "phrases": [["So, tell me about yourself.", "Biraz kendinden bahset."], ["What do you like doing in your free time?", "Boş zamanında ne yapmayı seversin?"], ["I've always wanted to try that.", "Bunu hep denemek istemişimdir."], ["I had a really great time.", "Gerçekten çok güzel vakit geçirdim."], ["Would you like to meet again?", "Tekrar buluşmak ister misin?"]]}, {"id": "neighbour", "cat": "Sosyal", "lv": "B1", "icon": "🏠", "title": "Komşuyla konuşmak", "en": "Talking to a neighbour", "setting": "An apartment building hallway", "you": "A resident", "ai": "Your noisy neighbour", "goal": "Gürültü sorununu kırmadan konuş ve çözüm bul.", "phrases": [["Sorry to bother you.", "Rahatsız ettiğim için kusura bakma."], ["The music was quite loud last night.", "Dün gece müzik epey yüksekti."], ["I have to get up early for work.", "İş için erken kalkmam gerekiyor."], ["Would you mind keeping it down after 11?", "11'den sonra sesi kısabilir misin?"], ["Thanks for understanding.", "Anlayışın için teşekkürler."]]}, {"id": "apologize", "cat": "Sosyal", "lv": "B1", "icon": "🙏", "title": "Özür dilemek", "en": "Apologizing", "setting": "A café", "you": "You (you were very late)", "ai": "An upset friend", "goal": "Samimi özür dile, sebebi açıkla, telafi öner.", "phrases": [["I'm really sorry I'm late.", "Geç kaldığım için gerçekten özür dilerim."], ["It won't happen again.", "Bir daha olmayacak."], ["I should have called you.", "Seni aramalıydım."], ["Let me make it up to you.", "Bunu telafi etmeme izin ver."], ["I hope you can forgive me.", "Umarım beni affedebilirsin."]]}, {"id": "condolence", "cat": "Sosyal", "lv": "B2", "icon": "🕊️", "title": "Başsağlığı", "en": "Offering condolences", "setting": "A conversation with a colleague", "you": "You", "ai": "A colleague who lost a family member", "goal": "Saygılı ve destekleyici şekilde başsağlığı dile.", "phrases": [["I'm so sorry for your loss.", "Başın sağ olsun."], ["If there's anything I can do, please let me know.", "Yapabileceğim bir şey varsa lütfen söyle."], ["She was a wonderful person.", "Harika bir insandı."], ["Take all the time you need.", "İhtiyacın olan kadar zaman ayır."], ["You're in my thoughts.", "Aklım sende."]]}, {"id": "job-interview", "cat": "İş", "lv": "B1", "icon": "💼", "title": "İş görüşmesi", "en": "Job interview", "setting": "An office interview room", "you": "A job candidate", "ai": "An HR manager", "goal": "Kendini tanıt, güçlü yanlarını anlat, soru sor.", "phrases": [["Thank you for inviting me.", "Beni davet ettiğiniz için teşekkürler."], ["I have three years of experience in sales.", "Satışta üç yıllık deneyimim var."], ["My greatest strength is problem-solving.", "En büyük güçlü yanım problem çözmek."], ["I'm a fast learner.", "Hızlı öğrenirim."], ["What would a typical day look like?", "Tipik bir gün nasıl geçer?"]]}, {"id": "job-interview-hard", "cat": "İş", "lv": "B2", "icon": "🎯", "title": "Zor mülakat soruları", "en": "Tough interview questions", "setting": "A senior interview", "you": "A candidate", "ai": "A strict interviewer", "goal": "Zayıf yön, maaş beklentisi ve 'neden ayrıldın' sorularını iyi cevapla.", "phrases": [["One area I'm working on is public speaking.", "Üzerinde çalıştığım bir alan topluluk önünde konuşmak."], ["I'm looking for new challenges.", "Yeni zorluklar arıyorum."], ["My salary expectation is in line with the market.", "Maaş beklentim piyasaya uygun."], ["Could you tell me more about the team?", "Ekip hakkında biraz daha bilgi verebilir misiniz?"], ["When can I expect to hear from you?", "Sizden ne zaman haber bekleyebilirim?"]]}, {"id": "meeting", "cat": "İş", "lv": "B2", "icon": "📊", "title": "Toplantıda fikir belirtmek", "en": "Speaking in a meeting", "setting": "A team meeting", "you": "A team member", "ai": "A manager and colleagues", "goal": "Fikrini söyle, katılmadığını kibarca belirt, öneri sun.", "phrases": [["I'd like to add something.", "Bir şey eklemek istiyorum."], ["I see your point, but…", "Ne demek istediğini anlıyorum ama…"], ["Could you clarify that?", "Bunu açabilir misin?"], ["What if we tried a different approach?", "Farklı bir yaklaşım denesek?"], ["Let's move on to the next item.", "Bir sonraki maddeye geçelim."]]}, {"id": "phone-business", "cat": "İş", "lv": "B1", "icon": "📞", "title": "İş telefonu", "en": "A business phone call", "setting": "A phone call", "you": "An employee", "ai": "A client", "goal": "Kendini tanıt, toplantı ayarla, mesaj bırak.", "phrases": [["Hello, this is Ayşe from TechCorp.", "Merhaba, ben TechCorp'tan Ayşe."], ["Could I speak to Mr. Brown, please?", "Bay Brown ile görüşebilir miyim lütfen?"], ["I'm calling about the contract.", "Sözleşme hakkında arıyorum."], ["Could you ask him to call me back?", "Beni geri aramasını söyleyebilir misiniz?"], ["Would Tuesday at 10 work for you?", "Salı saat 10 size uyar mı?"]]}, {"id": "email-request", "cat": "İş", "lv": "B1", "icon": "📧", "title": "Kibar talep", "en": "Making a polite request at work", "setting": "An office", "you": "An employee", "ai": "Your manager", "goal": "Yöneticinden izin günü ya da destek iste.", "phrases": [["I was wondering if I could take Friday off.", "Cuma izin alabilir miyim diye merak ediyordum."], ["Would it be possible to extend the deadline?", "Teslim tarihini uzatmak mümkün olur mu?"], ["I'd really appreciate your help.", "Yardımınızı gerçekten takdir ederim."], ["Let me know if that works.", "Uygun olup olmadığını bana bildirin."], ["Thanks in advance.", "Şimdiden teşekkürler."]]}, {"id": "presentation", "cat": "İş", "lv": "B2", "icon": "🎤", "title": "Sunum yapmak", "en": "Giving a presentation", "setting": "A conference room", "you": "A presenter", "ai": "An audience", "goal": "Sunumu aç, ana noktaları sırala, soruları al.", "phrases": [["Today I'm going to talk about…", "Bugün … hakkında konuşacağım."], ["Let me start with a quick overview.", "Kısa bir genel bakışla başlayayım."], ["As you can see on this slide…", "Bu slaytta gördüğünüz gibi…"], ["To sum up…", "Özetlemek gerekirse…"], ["Are there any questions?", "Sorusu olan var mı?"]]}, {"id": "negotiate-salary", "cat": "İş", "lv": "B2", "icon": "💰", "title": "Maaş pazarlığı", "en": "Negotiating salary", "setting": "A meeting with HR", "you": "A new employee", "ai": "An HR manager", "goal": "Teklife teşekkür et, gerekçeyle daha yüksek maaş iste.", "phrases": [["Thank you for the offer.", "Teklif için teşekkür ederim."], ["Based on my experience, I was expecting a bit more.", "Deneyimime dayanarak biraz daha fazlasını bekliyordum."], ["Is there any flexibility?", "Esneklik var mı?"], ["What about other benefits?", "Peki diğer yan haklar?"], ["I'm sure we can find a solution.", "Eminim bir çözüm bulabiliriz."]]}, {"id": "coworker-help", "cat": "İş", "lv": "A2", "icon": "🤝", "title": "İş arkadaşından yardım", "en": "Asking a coworker for help", "setting": "An office", "you": "An employee", "ai": "A coworker", "goal": "Bilgisayar sorunu için yardım iste ve teşekkür et.", "phrases": [["Do you have a minute?", "Bir dakikan var mı?"], ["I can't open this file.", "Bu dosyayı açamıyorum."], ["Could you show me how to do it?", "Nasıl yapıldığını gösterebilir misin?"], ["That makes sense.", "Bu mantıklı."], ["Thanks, I owe you one.", "Teşekkürler, sana borçluyum."]]}, {"id": "customer-service", "cat": "İş", "lv": "B1", "icon": "🎧", "title": "Müşteri hizmetleri", "en": "Calling customer service", "setting": "A phone call", "you": "A customer", "ai": "A support agent", "goal": "Faturadaki hatayı anlat ve düzeltilmesini sağla.", "phrases": [["I think there's a mistake on my bill.", "Sanırım faturamda bir hata var."], ["I was charged twice.", "İki kez ücretlendirildim."], ["My account number is…", "Hesap numaram…"], ["How long will it take to fix?", "Düzeltmek ne kadar sürer?"], ["Could you send me a confirmation email?", "Bana onay e-postası gönderebilir misiniz?"]]}, {"id": "bank", "cat": "Günlük işler", "lv": "B1", "icon": "🏦", "title": "Bankada", "en": "At the bank", "setting": "A bank branch", "you": "A customer", "ai": "A bank clerk", "goal": "Hesap aç, kart sorununu çöz.", "phrases": [["I'd like to open an account.", "Hesap açmak istiyorum."], ["My card has been blocked.", "Kartım bloke oldu."], ["What documents do I need?", "Hangi belgeler gerekiyor?"], ["What are the fees?", "Ücretler nedir?"], ["Can I do it online?", "İnternetten yapabilir miyim?"]]}, {"id": "post-office", "cat": "Günlük işler", "lv": "A2", "icon": "📮", "title": "Postanede", "en": "At the post office", "setting": "A post office", "you": "A customer", "ai": "A postal clerk", "goal": "Turkey'ye paket gönder, ücret ve süreyi öğren.", "phrases": [["I'd like to send this to Turkey.", "Bunu Türkiye'ye göndermek istiyorum."], ["How long will it take?", "Ne kadar sürer?"], ["How much does it cost?", "Ne kadar tutar?"], ["Can I track it?", "Takip edebilir miyim?"], ["It's fragile.", "Kırılabilir."]]}, {"id": "rent-flat", "cat": "Günlük işler", "lv": "B1", "icon": "🔑", "title": "Ev kiralamak", "en": "Renting a flat", "setting": "A flat viewing", "you": "A tenant", "ai": "A landlord", "goal": "Kirayı, faturaları ve depozitoyu sor; şartları anla.", "phrases": [["How much is the rent?", "Kira ne kadar?"], ["Are bills included?", "Faturalar dahil mi?"], ["How much is the deposit?", "Depozito ne kadar?"], ["Is it furnished?", "Eşyalı mı?"], ["When can I move in?", "Ne zaman taşınabilirim?"]]}, {"id": "hairdresser", "cat": "Günlük işler", "lv": "A2", "icon": "💇", "title": "Kuaförde", "en": "At the hairdresser's", "setting": "A hair salon", "you": "A customer", "ai": "A hairdresser", "goal": "Nasıl kestirmek istediğini anlat.", "phrases": [["Just a trim, please.", "Sadece uçlarından lütfen."], ["Not too short.", "Çok kısa olmasın."], ["Can you take a little off the sides?", "Yanlardan biraz alabilir misiniz?"], ["I'd like to dye my hair.", "Saçımı boyatmak istiyorum."], ["That looks great, thanks!", "Harika görünüyor, teşekkürler!"]]}, {"id": "gym", "cat": "Günlük işler", "lv": "A2", "icon": "🏋️", "title": "Spor salonu üyeliği", "en": "Joining a gym", "setting": "A gym reception", "you": "A new member", "ai": "A gym receptionist", "goal": "Üyelik türlerini, fiyatı ve saatleri öğren.", "phrases": [["I'm interested in joining.", "Üye olmakla ilgileniyorum."], ["How much is a monthly membership?", "Aylık üyelik ne kadar?"], ["What are your opening hours?", "Çalışma saatleriniz nedir?"], ["Do you offer personal training?", "Kişisel antrenörlük veriyor musunuz?"], ["Can I have a free trial?", "Ücretsiz deneme alabilir miyim?"]]}, {"id": "repair", "cat": "Günlük işler", "lv": "B1", "icon": "🔧", "title": "Tamirci çağırmak", "en": "Calling a repair person", "setting": "A phone call", "you": "A home owner", "ai": "A plumber", "goal": "Sızıntıyı anlat, randevu ayarla, fiyat sor.", "phrases": [["There's a leak under the kitchen sink.", "Mutfak lavabosunun altında sızıntı var."], ["Could you come today?", "Bugün gelebilir misiniz?"], ["Roughly how much will it cost?", "Kabaca ne kadar tutar?"], ["It's getting worse.", "Gittikçe kötüleşiyor."], ["I'll be home all afternoon.", "Bütün öğleden sonra evdeyim."]]}, {"id": "police", "cat": "Günlük işler", "lv": "B1", "icon": "👮", "title": "Polise bildirmek", "en": "Reporting a theft", "setting": "A police station", "you": "A victim", "ai": "A police officer", "goal": "Çalınan eşyayı ve olayı anlat, rapor al.", "phrases": [["I'd like to report a theft.", "Bir hırsızlığı bildirmek istiyorum."], ["My wallet was stolen.", "Cüzdanım çalındı."], ["It happened about an hour ago.", "Yaklaşık bir saat önce oldu."], ["I didn't see his face.", "Yüzünü görmedim."], ["Can I get a copy of the report?", "Raporun bir kopyasını alabilir miyim?"]]}, {"id": "school-parent", "cat": "Eğitim", "lv": "B1", "icon": "🏫", "title": "Veli toplantısı", "en": "Parent–teacher meeting", "setting": "A classroom", "you": "A parent", "ai": "A teacher", "goal": "Çocuğunun durumunu sor, nasıl destek olacağını öğren.", "phrases": [["How is my son doing in class?", "Oğlum derste nasıl?"], ["Is he having any difficulties?", "Zorlandığı bir şey var mı?"], ["How can we help him at home?", "Evde ona nasıl yardım edebiliriz?"], ["He seems more motivated lately.", "Son zamanlarda daha motive görünüyor."], ["Thanks for your time.", "Zaman ayırdığınız için teşekkürler."]]}, {"id": "university-office", "cat": "Eğitim", "lv": "B1", "icon": "🎓", "title": "Öğrenci işleri", "en": "At the student office", "setting": "A university office", "you": "A student", "ai": "An administrator", "goal": "Ders kaydı ve belge talebini halle.", "phrases": [["I'd like to register for this course.", "Bu derse kayıt olmak istiyorum."], ["I need a student certificate.", "Öğrenci belgesine ihtiyacım var."], ["What's the deadline?", "Son tarih ne?"], ["Where do I submit the form?", "Formu nereye teslim ediyorum?"], ["Is it possible to change my schedule?", "Programımı değiştirmek mümkün mü?"]]}, {"id": "language-exchange", "cat": "Eğitim", "lv": "A2", "icon": "🗣️", "title": "Dil değişimi", "en": "Language exchange", "setting": "An online video call", "you": "A Turkish learner of English", "ai": "A British learner of Turkish", "goal": "Kendini tanıt, nasıl çalışacağınızı planlayın.", "phrases": [["Shall we speak English first, then Turkish?", "Önce İngilizce, sonra Türkçe konuşalım mı?"], ["Please correct my mistakes.", "Lütfen hatalarımı düzelt."], ["How do you say this in English?", "Bunu İngilizce nasıl söylersin?"], ["Could you speak a bit more slowly?", "Biraz daha yavaş konuşabilir misin?"], ["Same time next week?", "Gelecek hafta aynı saatte?"]]}, {"id": "ielts-part1", "cat": "Sınav", "lv": "B1", "icon": "📝", "title": "IELTS Bölüm 1", "en": "IELTS Speaking Part 1", "setting": "An exam room", "you": "A candidate", "ai": "An examiner", "goal": "Kişisel sorulara 2-3 cümleyle, örnek vererek cevap ver.", "phrases": [["Well, that's an interesting question.", "Bu ilginç bir soru."], ["To be honest, I'm not really into…", "Dürüst olmak gerekirse … pek ilgimi çekmez."], ["For example, …", "Örneğin, …"], ["I'd say that…", "… diyebilirim."], ["It depends on the situation.", "Duruma bağlı."]]}, {"id": "ielts-part2", "cat": "Sınav", "lv": "B2", "icon": "⏱️", "title": "IELTS Bölüm 2", "en": "IELTS cue card", "setting": "An exam room", "you": "A candidate", "ai": "An examiner", "goal": "2 dakika boyunca bir konuyu yapılandırarak anlat.", "phrases": [["I'd like to talk about…", "… hakkında konuşmak istiyorum."], ["The first thing I'd mention is…", "Bahsedeceğim ilk şey…"], ["What made it special was…", "Onu özel yapan şey…"], ["Looking back, …", "Geriye dönüp bakınca, …"], ["That's why it means so much to me.", "Bu yüzden benim için çok anlamlı."]]}, {"id": "ielts-part3", "cat": "Sınav", "lv": "B2", "icon": "🧠", "title": "IELTS Bölüm 3", "en": "IELTS discussion", "setting": "An exam room", "you": "A candidate", "ai": "An examiner", "goal": "Soyut konularda fikir belirt, karşılaştır, gerekçelendir.", "phrases": [["On the one hand…, on the other hand…", "Bir yandan…, öte yandan…"], ["I strongly believe that…", "… olduğuna kuvvetle inanıyorum."], ["There are several reasons for this.", "Bunun birkaç nedeni var."], ["In the long run, …", "Uzun vadede, …"], ["It's a complex issue.", "Karmaşık bir konu."]]}, {"id": "opinion", "cat": "Fikir", "lv": "B2", "icon": "💭", "title": "Tartışma", "en": "Debating an opinion", "setting": "A discussion with a friend", "you": "You", "ai": "A friend with the opposite view", "goal": "Fikrini savun, karşı tarafı dinle, ortak nokta bul.", "phrases": [["In my opinion…", "Bence…"], ["I couldn't agree more.", "Sonuna kadar katılıyorum."], ["I'm not sure I agree.", "Katıldığımdan emin değilim."], ["That's a fair point, but…", "Haklı bir nokta, ama…"], ["Let's agree to disagree.", "Farklı düşündüğümüzü kabul edelim."]]}, {"id": "tech-support", "cat": "Teknoloji", "lv": "B1", "icon": "💻", "title": "Teknik destek", "en": "Tech support call", "setting": "A phone call", "you": "A user", "ai": "A tech support agent", "goal": "İnternet sorununu anlat, adımları takip et.", "phrases": [["My internet keeps disconnecting.", "İnternetim sürekli kopuyor."], ["I've already restarted the router.", "Modemi zaten yeniden başlattım."], ["The light is flashing red.", "Işık kırmızı yanıp sönüyor."], ["What should I do next?", "Şimdi ne yapmalıyım?"], ["It's working now, thank you!", "Şimdi çalışıyor, teşekkürler!"]]}, {"id": "phone-shop", "cat": "Teknoloji", "lv": "A2", "icon": "📱", "title": "Telefon hattı almak", "en": "Getting a SIM card", "setting": "A mobile phone shop", "you": "A tourist", "ai": "A shop assistant", "goal": "Turist için uygun bir hat ve internet paketi al.", "phrases": [["I need a SIM card for two weeks.", "İki haftalık bir SIM karta ihtiyacım var."], ["How much data does it include?", "Ne kadar internet içeriyor?"], ["Can I use it abroad?", "Yurtdışında kullanabilir miyim?"], ["Do you need my passport?", "Pasaportuma ihtiyacınız var mı?"], ["How do I top it up?", "Nasıl kontör yüklerim?"]]}, {"id": "football", "cat": "Hobiler", "lv": "A2", "icon": "⚽", "title": "Maç sohbeti", "en": "Talking about football", "setting": "A café during a match", "you": "A football fan", "ai": "Another fan", "goal": "Takımını, maçı ve oyuncuları konuş.", "phrases": [["Who do you support?", "Hangi takımı tutuyorsun?"], ["What a goal!", "Ne gol ama!"], ["That was definitely a penalty.", "Kesinlikle penaltıydı."], ["They played really well in the second half.", "İkinci yarıda gerçekten iyi oynadılar."], ["Who's playing tonight?", "Bu akşam kim oynuyor?"]]}, {"id": "movies", "cat": "Hobiler", "lv": "A2", "icon": "🎬", "title": "Film konuşmak", "en": "Talking about films", "setting": "A cinema lobby", "you": "You", "ai": "A friend", "goal": "İzlediğin filmi anlat, öneri iste.", "phrases": [["Have you seen the new Marvel film?", "Yeni Marvel filmini gördün mü?"], ["It was better than I expected.", "Beklediğimden iyiydi."], ["The ending was a bit disappointing.", "Sonu biraz hayal kırıklığıydı."], ["What kind of films do you like?", "Ne tür filmlerden hoşlanırsın?"], ["You should definitely watch it.", "Kesinlikle izlemelisin."]]}, {"id": "hobbies", "cat": "Hobiler", "lv": "A1", "icon": "🎨", "title": "Hobiler", "en": "Talking about hobbies", "setting": "A language class", "you": "A student", "ai": "A classmate", "goal": "Hobilerini ve ne sıklıkla yaptığını anlat.", "phrases": [["What do you do in your free time?", "Boş zamanında ne yaparsın?"], ["I love playing the guitar.", "Gitar çalmayı çok severim."], ["I go swimming twice a week.", "Haftada iki kez yüzmeye giderim."], ["I'm not very good at it.", "Pek iyi değilim."], ["How about you?", "Peki ya sen?"]]}, {"id": "cooking", "cat": "Hobiler", "lv": "B1", "icon": "🍳", "title": "Tarif anlatmak", "en": "Explaining a recipe", "setting": "A kitchen", "you": "You", "ai": "A foreign friend", "goal": "Bir Türk yemeğinin tarifini adım adım anlat.", "phrases": [["First, chop the onions.", "Önce soğanları doğra."], ["Then fry them until golden.", "Sonra altın rengi olana kadar kızart."], ["Add a pinch of salt.", "Bir tutam tuz ekle."], ["Let it simmer for 20 minutes.", "20 dakika kısık ateşte pişsin."], ["Serve it with yogurt.", "Yoğurtla servis et."]]}, {"id": "family", "cat": "Kişisel", "lv": "A1", "icon": "👨‍👩‍👧", "title": "Aileni anlatmak", "en": "Talking about your family", "setting": "A conversation", "you": "You", "ai": "A new friend", "goal": "Ailen hakkında bilgi ver ve karşı tarafa sor.", "phrases": [["I have one brother and two sisters.", "Bir erkek ve iki kız kardeşim var."], ["My father is a teacher.", "Babam öğretmen."], ["We live in Izmir.", "İzmir'de yaşıyoruz."], ["I'm the youngest.", "En küçük benim."], ["Do you have any brothers or sisters?", "Kardeşin var mı?"]]}, {"id": "daily-routine", "cat": "Kişisel", "lv": "A1", "icon": "⏰", "title": "Günlük rutin", "en": "Your daily routine", "setting": "A conversation", "you": "You", "ai": "A classmate", "goal": "Günün nasıl geçtiğini saatleriyle anlat.", "phrases": [["I usually get up at seven.", "Genelde yedide kalkarım."], ["I have breakfast at home.", "Kahvaltıyı evde yaparım."], ["I start work at nine.", "İşe dokuzda başlarım."], ["In the evening, I watch TV.", "Akşamları televizyon izlerim."], ["I go to bed around eleven.", "On bir civarı yatarım."]]}, {"id": "feelings", "cat": "Kişisel", "lv": "B1", "icon": "💬", "title": "Duygularını anlatmak", "en": "Talking about feelings", "setting": "A conversation with a close friend", "you": "You", "ai": "A close friend", "goal": "Stresli olduğunu anlat, tavsiye al.", "phrases": [["I've been really stressed lately.", "Son zamanlarda çok stresliyim."], ["I feel overwhelmed.", "Bunalmış hissediyorum."], ["I don't know what to do.", "Ne yapacağımı bilmiyorum."], ["Thanks for listening.", "Dinlediğin için teşekkürler."], ["That really helps.", "Bu gerçekten yardımcı oluyor."]]}, {"id": "future-plans", "cat": "Kişisel", "lv": "B1", "icon": "🚀", "title": "Gelecek planları", "en": "Talking about future plans", "setting": "A conv
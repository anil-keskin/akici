al": "Uzun süredir çözülmeyen nem sorununu kararlı ve kibar şekilde çöz.", "phrases": [["I've reported this problem several times.", "Bu sorunu birkaç kez bildirdim."], ["It's affecting my health.", "Sağlığımı etkiliyor."], ["I need it fixed by the end of the week.", "Hafta sonuna kadar düzeltilmesi gerekiyor."], ["According to the contract…", "Sözleşmeye göre…"], ["Otherwise, I'll have to take further action.", "Aksi takdirde başka adımlar atmak zorunda kalacağım."]]}, {"id": "networking", "cat": "İş", "lv": "B2", "icon": "🌐", "title": "Etkinlikte network", "en": "Networking at an event", "setting": "A business conference", "you": "A professional", "ai": "Another professional", "goal": "Kendini ve işini tanıt, kartvizit değiş, iletişimde kal.", "phrases": [["What brings you to this conference?", "Sizi bu konferansa ne getirdi?"], ["I work in digital marketing.", "Dijital pazarlamada çalışıyorum."], ["That sounds fascinating.", "Kulağa çok ilginç geliyor."], ["Here's my card.", "Kartım burada."], ["Let's keep in touch.", "İletişimde kalalım."]]}, {"id": "performance-review", "cat": "İş", "lv": "C1", "icon": "📈", "title": "Performans değerlendirmesi", "en": "Performance review", "setting": "A manager's office", "you": "An employee", "ai": "A manager", "goal": "Başarılarını anlat, eleştiriyi profesyonelce karşıla, terfi iste.", "phrases": [["I'm proud of what I achieved this year.", "Bu yıl başardıklarımla gurur duyuyorum."], ["I appreciate the feedback.", "Geri bildiriminiz için teşekkür ederim."], ["I'd like to take on more responsibility.", "Daha fazla sorumluluk almak istiyorum."], ["What would I need to do to get promoted?", "Terfi almak için ne yapmam gerekir?"], ["Could we set some clear goals?", "Net hedefler belirleyebilir miyiz?"]]}, {"id": "startup-pitch", "cat": "İş", "lv": "C1", "icon": "🚀", "title": "Yatırımcı sunumu", "en": "Pitching to an investor", "setting": "An investor meeting", "you": "A startup founder", "ai": "An investor", "goal": "Problemi, çö
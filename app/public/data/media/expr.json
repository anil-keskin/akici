[{"en": "No way!", "tr": "Yok artık! / Olamaz!", "note": "şaşkınlık", "cat": "Tepki"}, {"en": "You've got to be kidding me.", "tr": "Dalga geçiyorsun herhalde.", "note": "inanmama", "cat": "Tepki"}, {"en": "Tell me about it.", "tr": "Hiç sorma. / Aynen öyle.", "note": "katılma (iğneleme değil)", "cat": "Tepki"}, {"en": "I'm all ears.", "tr": "Dinliyorum, anlat.", "note": "merak", "cat": "Tepki"}, {"en": "That's the spirit!", "tr": "İşte bu! / Bu kafayla devam!", "note": "cesaretlendirme", "cat": "Tepki"}, {"en": "Fair enough.", "tr": "Mantıklı. / Haklısın.", "note": "kabul", "cat": "Tepki"}, {"en": "Good for you!", "tr": "Aferin sana! / Ne güzel!", "note": "tebrik", "cat": "Tepki"}, {"en": "Big deal.", "tr": "Ne olmuş yani.", "note": "küçümseme", "cat": "Tepki"}, {"en": "Whatever.", "tr": "Neyse. / Her neyse.", "note": "ilgisizlik (kaba olabilir)", "cat": "Tepki"}, {"en": "Same here.", "tr": "Bende de öyle.", "note": "katılma", "cat": "Tepki"}, {"en": "You bet!", "tr": "Kesinlikle! / Ne demezsin!", "note": "onay", "cat": "Tepki"}, {"en": "I knew it!", "tr": "Biliyordum!", "note": "tahmin doğru çıktı", "cat": "Tepki"}, {"en": "Oh my God.", "tr": "Aman Tanrım.", "note": "şaşkınlık", "cat": "Tepki"}, {"en": "That's insane.", "tr": "Bu çılgınca.", "note": "aşırı şaşkınlık", "cat": "Tepki"}, {"en": "Seriously?", "tr": "Cidden mi?", "note": "inanmama", "cat": "Tepki"}, {"en": "Gross!", "tr": "İğrenç!", "note": "tiksinme", "cat": "Tepki"}, {"en": "Awesome!", "tr": "Harika!", "note": "sevinç", "cat": "Tepki"}, {"en": "Bummer.", "tr": "Hay aksi. / Ne kötü.", "note": "hayal kırıklığı", "cat": "Tepki"}, {"en": "Get out of here!", "tr": "Hadi canım! (inanmama)", "note": "şaşkınlık, kovma değil", "cat": "Tepki"}, {"en": "What's up?", "tr": "Naber?", "note": "selam", "cat": "Sohbet"}, {"en": "How's it going?", "tr": "Nasıl gidiyor?", "note": "selam", "cat": "Sohbet"}, {"en": "Long time no see.", "tr": "Görüşmeyeli uzun zaman oldu.", "note": "selam", "cat": "Sohbet"}, {"en": "What have you been up to?", "tr": "Neler yapıyorsun bu aralar?", "note": "sohbet açma", "cat": "Sohbet"}, {"en": "Speaking of which...", "tr": "Laf açılmışken...", "note": "konu bağlama", "cat": "Sohbet"}, {"en": "By the way...", "tr": "Bu arada...", "note": "konu açma", "cat": "Sohbet"}, {"en": "Anyway...", "tr": "Neyse...", "note": "konuya dönme", "cat": "Sohbet"}, {"en": "Long story short...", "tr": "Uzun lafın kısası...", "note": "özetleme", "cat": "Sohbet"}, {"en": "To be honest...", "tr": "Açıkçası...", "note": "dürüstlük", "cat": "Sohbet"}, {"en": "You know what?", "tr": "Biliyor musun?", "note": "dikkat çekme", "cat": "Sohbet"}, {"en": "Guess what!", "tr": "Bil bakalım ne oldu!", "note": "haber verme", "cat": "Sohbet"}, {"en": "I mean...", "tr": "Yani...", "note": "açıklama", "cat": "Sohbet"}, {"en": "Let me put it this way.", "tr": "Şöyle söyleyeyim.", "note": "açıklama", "cat": "Sohbet"}, {"en": "Where was I?", "tr": "Nerede kalmıştım?", "note": "konuya dönme", "cat": "Sohbet"}, {"en": "It slipped my mind.", "tr": "Aklımdan çıkmış.", "note": "unutma", "cat": "Sohbet"}, {"en": "It rings a bell.", "tr": "Tanıdık geliyor.", "note": "hatırlama", "cat": "Sohbet"}, {"en": "I'll keep you posted.", "tr": "Seni haberdar ederim.", "note": "bilgi verme", "cat": "Sohbet"}, {"en": "Catch you later.", "tr": "Sonra görüşürüz.", "note": "vedalaşma", "cat": "Sohbet"}, {"en": "Take care.", "tr": "Kendine iyi bak.", "note": "vedalaşma", "cat": "Sohbet"}, {"en": "I've got to go.", "tr": "Gitmem lazım.", "note": "vedalaşma", "cat": "Sohbet"}, {"en": "I'm fed up with this.", "tr": "Bundan bıktım.", "note": "bıkkınlık", "cat": "Duygu"}, {"en": "I'm freaking out.", "tr": "Kafayı yemek üzereyim. / Panik oldum.", "note": "panik", "cat": "Duygu"}, {"en": "I can't stand it.", "tr": "Buna dayanamıyorum.", "note": "tahammülsüzlük", "cat": "Duygu"}, {"en": "It's killing me.", "tr": "Beni mahvediyor. / Merakımdan çatlıyorum.", "note": "yoğun duygu", "cat": "Duygu"}, {"en": "I'm over the moon
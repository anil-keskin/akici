 {"en": "Hurry up!", "tr": "Acele et!", "note": "acele", "cat": "Karar ve plan"}, {"en": "We're running out of time.", "tr": "Vaktimiz azalıyor.", "note": "acele", "cat": "Karar ve plan"}, {"en": "Let's get going.", "tr": "Hadi gidelim.", "note": "başlama", "cat": "Karar ve plan"}, {"en": "Here we go.", "tr": "İşte başlıyoruz. / Al işte.", "note": "başlama", "cat": "Karar ve plan"}, {"en": "Game over.", "tr": "Oyun bitti. / Her şey bitti.", "note": "son", "cat": "Karar ve plan"}, {"en": "That's not the point.", "tr": "Mesele o değil.", "note": "itiraz", "cat": "Tartışma"}, {"en": "You're missing the point.", "tr": "Asıl noktayı kaçırıyorsun.", "note": "itiraz", "cat": "Tartışma"}, {"en": "Give me a break.", "tr": "Yapma ya. / Bırak Allah aşkına.", "note": "bıkkınlık", "cat": "Tartışma"}, {"en": "Mind your own business.", "tr": "Sen kendi işine bak.", "note": "kaba", "cat": "Tartışma"}, {"en": "Back off!", "tr": "Geri çekil! / Bulaşma!", "note": "kaba", "cat": "Tartışma"}, {"en": "Watch your mouth.", "tr": "Ağzını topla.", "note": "uyarı", "cat": "Tartışma"}, {"en": "How dare you?", "tr": "Ne cüretle?", "note": "öfke", "cat": "Tartışma"}, {"en": "Don't get me wrong.", "tr": "Yanlış anlama.", "note": "yumuşatma", "cat": "Tartışma"}, {"en": "I didn't mean it.", "tr": "Öyle demek istemedim.", "note": "özür", "cat": "Tartışma"}, {"en": "My bad.", "tr": "Benim hatam.", "note": "özür (gündelik)", "cat": "Tartışma"}, {"en": "Let it go.", "tr": "Boş ver. / Takılma.", "note": "sakinleştirme", "cat": "Tartışma"}, {"en": "Get over it.", "tr": "Artık aş bunu.", "note": "sertçe", "cat": "Tartışma"}, {"en": "It's not my fault.", "tr": "Benim suçum değil.", "note": "savunma", "cat": "Tartışma"}, {"en": "Says who?", "tr": "Kim demiş?", "note": "itiraz", "cat": "Tartışma"}, {"en": "You asked for it.", "tr": "Sen istedin. / Hak ettin.", "note": "suçlama", "cat": "Tartışma"}, {"en": "Point taken.", "tr": "Anladım, haklısın.", "note": "kabul", "cat": "Tartışma"}, {"en": "Agree to disagree.", "tr": "Anlaşamadığımızda anlaşalım.", "note": "uzlaşma", "cat": "Tartışma"}, {"en": "I'm swamped.", "tr": "İşten başımı kaşıyacak vaktim yok.", "note": "yoğunluk", "cat": "İş ve okul"}, {"en": "Let's touch base.", "tr": "Bir haberleşelim. / Kısa bir görüşelim.", "note": "iş dili", "cat": "İş ve okul"}, {"en": "I'm on it.", "tr": "Hallediyorum. / İlgileniyorum.", "note": "sorumluluk", "cat": "İş ve okul"}, {"en": "Got it.", "tr": "Anladım. / Tamamdır.", "note": "onay", "cat": "İş ve okul"}, {"en": "Bear with me.", "tr": "Biraz sabret.", "note": "bekletme", "cat": "İş ve okul"}, {"en": "It's a piece of cake.", "tr": "Çocuk oyuncağı.", "note": "kolay", "cat": "İş ve okul"}, {"en": "I'm running late.", "tr": "Geç kalıyorum.", "note": "gecikme", "cat": "İş ve okul"}, {"en": "Let me get back to you.", "tr": "Sana dönüş yapayım.", "note": "iş dili", "cat": "İş ve okul"}, {"en": "Keep up the good work.", "tr": "Böyle devam.", "note": "övgü", "cat": "İş ve okul"}, {"en": "You nailed it!", "tr": "Tam on ikiden vurdun! / Harika yaptın!", "note": "övgü", "cat": "İş ve okul"}, {"en": "It's a long shot.", "tr": "Pek olası değil ama deneriz.", "note": "düşük ihtimal", "cat": "İş ve okul"}, {"en": "Back to square one.", "tr": "Başa döndük.", "note": "başarısızlık", "cat": "İş ve okul"}, {"en": "We're on the same page.", "tr": "Aynı fikirdeyiz.", "note": "uyum", "cat": "İş ve okul"}, {"en": "Think outside the box.", "tr": "Kalıpların dışında düşün.", "note": "yaratıcılık", "cat": "İş ve okul"}, {"en": "We need to talk.", "tr": "Konuşmamız lazım.", "note": "ciddi konu", "cat": "Dizi klasikleri"}, {"en": "It's not what it looks like!", "tr": "Göründüğü gibi değil!", "note": "yakalanma", "cat": "Dizi klasikleri"}, {"en": "Trust me.", "tr": "Bana güven.", "note": "ikna", "cat": "Dizi klasikleri"}, {"en": "I've got a bad feeling about this.", "tr": "Bu işten hiç hoşlanmadım. / İçim rahat değil.", "note": "sezgi", "cat": "Dizi klasikleri"}, {"en": "Leave me alone.", "tr": "Beni yalnız bırak.", "note": "uzaklaşma", "cat": "Dizi klasikleri"}, {"en": "I can explain.", "tr": "Açıklayabilirim.", "note": "savunma", "cat": "Dizi klasikleri"}, {"en": "What are you doing here?", "tr": "Ne işin var burada?", "note": "şaşkınlık", "cat": "Dizi klasikleri"}, {"en": "You're not gonna believe this.", "tr": "Buna inanmayacaksın.", "note": "haber", "cat": "Dizi klasikleri"}, {"en": "It's now or never.", "tr": "Ya şimdi ya hiç.", "note": "karar", "cat": "Dizi klasikleri"}, {"en": "Whatever it takes.", "tr": "Ne gerekiyorsa.", "note": "kararlılık", "cat": "Dizi klasikleri"}, {"en": "I'm not going anywhere.", "tr": "Hiçbir yere gitmiyorum.", "note": "bağlılık", "cat": "Dizi klasikleri"}, {"en": "Don't do anything stupid.", "tr": "Aptalca bir şey yapma.", "note": "uyarı", "cat": "Dizi klasikleri"}, {"en": "Stay with me!", "tr": "Benimle kal! / Dayan!", "note": "acil durum", "cat": "Dizi klasikleri"}, {"en": "Get in the car.", "tr": "Arabaya bin.", "note": "acele", "cat": "Dizi klasikleri"}, {"en": "We've got company.", "tr": "Misafirimiz var. (tehlike geliyor)", "note": "tehlike", "cat": "Dizi klasikleri"}, {"en": "It's complicated.", "tr": "Karışık. / Durum karmaşık.", "note": "ilişki", "cat": "Dizi klasikleri"}, {"en": "I'm sorry for your loss.", "tr": "Başınız sağ olsun.", "note": "taziye", "cat": "Dizi klasikleri"}, {"en": "Are you out of your mind?", "tr": "Aklını mı kaçırdın?", "note": "şaşkınlık", "cat": "Dizi klasikleri"}, {"en": "Over my dead body.", "tr": "Ölümü çiğnemeden geçemezsin. / Asla.", "note": "ret", "cat": "Dizi klasikleri"}, {"en": "Not on my watch.", "tr": "Ben buradayken olmaz.", "note": "koruma", "cat": "Dizi klasikleri"}, {"en": "I'm broke.", "tr": "Meteliksizim.", "note": "para", "cat": "Argo (gündelik)"}, {"en": "That's sick!", "tr": "Bu müthiş!", "note": "argo övgü", "cat": "Argo (gündelik)"}, {"en": "No big deal.", "tr": "Sorun değil.", "note": "rahatlatma", "cat": "Argo (gündelik)"}, {"en": "I'm beat.", "tr": "Çok yorgunum. / Bittim."